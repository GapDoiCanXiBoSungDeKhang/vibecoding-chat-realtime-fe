# ============================================================
# Antigravity Chat App — Frontend Environment Variables
# ============================================================
# Copy file này thành ".env" rồi điền giá trị thật:
#   cp .env.example .env
#
# File .env.example NÀY được commit lên Git để team biết cần
# khai báo những biến gì. File .env thật KHÔNG được commit.
# ============================================================

# URL gốc của Backend API (bao gồm /api ở cuối)
# - Local dev:  http://localhost:3000/api
# - LAN (test trên điện thoại cùng mạng): http://<IP-máy>:3000/api
# - Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3000/api
